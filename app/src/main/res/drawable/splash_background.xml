<?xml version="1.0" encoding="utf-8"?>
<!--
  Window background shown from process start until the first Compose frame.
  Dark navy (matches every app theme) with the logo centred, so a cold start
  never flashes plain white and the hand-off to the library is seamless.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1A2E" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/ic_splash_logo"
        android:gravity="center" />
</layer-list>
